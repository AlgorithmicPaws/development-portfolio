---
interface Props {
  title: string;
  description: string;
  descriptionEs?: string;
  tags: string[];
  images: string[];
  githubLink: string;
  liveLink?: string;
}

const { title, description, descriptionEs, tags, images, githubLink, liveLink } = Astro.props;

const projectData = JSON.stringify({ title, description, descriptionEs: descriptionEs ?? '', tags, images, githubLink, liveLink: liveLink ?? '' });
---

<article class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 flex flex-col h-full group transform hover:-translate-y-2">
  <div class="relative">
    <img src={images[0]} alt={title} class="w-full h-48 object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
      <button
        class="open-modal-btn w-full text-center bg-brand-navy text-white py-2 hover:bg-brand-navy/80 transition-colors cursor-pointer"
        data-project={projectData}
      >
        <span class="inline-flex items-center justify-center gap-1 pointer-events-none">
          <span data-i18n="projects.viewDetails">View Details</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
      </button>
    </div>
  </div>
  <div class="p-4 flex-grow flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold mb-2 group-hover:text-brand-navy transition-colors">{title}</h3>
      {descriptionEs ? (
        <>
          <p class="text-gray-700 mb-4" data-lang-content="en">{description}</p>
          <p class="text-gray-700 mb-4" data-lang-content="es">{descriptionEs}</p>
        </>
      ) : (
        <p class="text-gray-700 mb-4">{description}</p>
      )}
    </div>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded-full text-xs hover:bg-brand-navy/10 transition-colors">{tag}</span>
      ))}
    </div>
  </div>
</article>
