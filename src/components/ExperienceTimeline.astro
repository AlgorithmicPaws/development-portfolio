---
import { experiencesEN, experiencesES } from '../data/experiences';

const initialEN = experiencesEN.slice(0, 4);
const initialES = experiencesES.slice(0, 4);
const hasMore = experiencesEN.length > 4;
---

<div class="mx-auto max-w-4xl py-8">

  <!-- English -->
  <div data-lang-content="en">
    {initialEN.map((exp) => (
      <div class="mb-12 grid grid-cols-[1fr] md:grid-cols-[70px_1fr] gap-6 relative">
        <div class="hidden md:flex flex-col items-center">
          <div class="w-4 h-4 rounded-full bg-brand-navy mb-2 shadow-[0_0_0_4px_rgba(255,255,255,1)]"></div>
          <div class="w-1 bg-gray-200 h-full"></div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border-l-4 border-brand-navy">
          <span class="inline-block px-3 py-1 text-sm rounded-full bg-brand-gold text-white font-semibold mb-2 shadow-sm">{exp.date}</span>
          <h3 class="text-xl font-bold mb-1 text-brand-navy">{exp.title}</h3>
          <h4 class="text-lg text-brand-red mb-1">{exp.company}</h4>
          <p class="text-gray-600 mb-3 text-sm italic flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {exp.location}
          </p>
          <ul class="text-gray-700 space-y-2">
            {exp.achievements.map((a) => (
              <li class="pl-5 relative before:absolute before:left-0 before:top-2 before:w-3 before:h-3 before:bg-brand-orange before:rounded-full">{a}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>

  <!-- Spanish -->
  <div data-lang-content="es">
    {initialES.map((exp) => (
      <div class="mb-12 grid grid-cols-[1fr] md:grid-cols-[70px_1fr] gap-6 relative">
        <div class="hidden md:flex flex-col items-center">
          <div class="w-4 h-4 rounded-full bg-brand-navy mb-2 shadow-[0_0_0_4px_rgba(255,255,255,1)]"></div>
          <div class="w-1 bg-gray-200 h-full"></div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border-l-4 border-brand-navy">
          <span class="inline-block px-3 py-1 text-sm rounded-full bg-brand-gold text-white font-semibold mb-2 shadow-sm">{exp.date}</span>
          <h3 class="text-xl font-bold mb-1 text-brand-navy">{exp.title}</h3>
          <h4 class="text-lg text-brand-red mb-1">{exp.company}</h4>
          <p class="text-gray-600 mb-3 text-sm italic flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {exp.location}
          </p>
          <ul class="text-gray-700 space-y-2">
            {exp.achievements.map((a) => (
              <li class="pl-5 relative before:absolute before:left-0 before:top-2 before:w-3 before:h-3 before:bg-brand-orange before:rounded-full">{a}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>

  {hasMore && (
    <div class="text-center mt-8">
      <a href="/experience" class="inline-flex items-center justify-center gap-2 bg-brand-navy text-white px-6 py-3 rounded-full hover:bg-brand-navy/80 transition-all duration-300 transform hover:-translate-y-1 shadow-md hover:shadow-lg">
        <span data-i18n="experience.viewAll">View all experience</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  )}
</div>
