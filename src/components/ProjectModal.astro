---
---

<!-- Project Modal -->
<div
  id="projectModal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 md:p-6 bg-black/70 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalTitle"
>
  <div class="modal-panel relative bg-white rounded-2xl w-full max-w-7xl shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-[55%_45%] max-h-[92vh]">

    <!-- Close button — top-right of the modal -->
    <button
      id="modalClose"
      class="absolute top-3 right-3 z-20 bg-brand-red hover:bg-brand-red/80 text-white rounded-full w-9 h-9 flex items-center justify-center transition-all shadow-md hover:shadow-lg"
      aria-label="Close modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- LEFT (desktop) / TOP (mobile): Carousel -->
    <div class="relative bg-gray-900 overflow-hidden h-64 md:h-auto md:min-h-[480px] md:col-start-1 md:row-start-1">
      <div id="carouselTrack" class="flex h-full transition-transform duration-300 ease-in-out"></div>

      <!-- Prev / Next -->
      <button
        id="carouselPrev"
        class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full w-9 h-9 flex items-center justify-center transition-colors hidden"
        aria-label="Previous image"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="carouselNext"
        class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full w-9 h-9 flex items-center justify-center transition-colors hidden"
        aria-label="Next image"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Dots -->
      <div id="carouselDots" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2 hidden"></div>
    </div>

    <!-- RIGHT (desktop) / BOTTOM (mobile): Content -->
    <div class="flex flex-col gap-5 p-8 overflow-y-auto md:col-start-2 md:row-start-1">

      <h3 id="modalTitle" class="text-2xl md:text-3xl font-bold text-brand-navy leading-tight pt-2"></h3>

      <!-- Description (bilingual) -->
      <div>
        <p id="modalDescEn" data-lang-content="en" class="text-gray-600 leading-relaxed"></p>
        <p id="modalDescEs" data-lang-content="es" class="text-gray-600 leading-relaxed"></p>
      </div>

      <!-- Tags -->
      <div id="modalTags" class="flex flex-wrap gap-2"></div>

      <!-- Links -->
      <div id="modalLinks" class="flex flex-wrap gap-3 mt-auto pt-5 border-t border-gray-100">
        <a
          id="modalGithub"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2 bg-brand-navy text-white rounded-full hover:bg-brand-navy/80 transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 transform font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span data-i18n="projects.github">GitHub</span>
        </a>
        <a
          id="modalLive"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden inline-flex items-center gap-2 px-5 py-2 bg-brand-red text-white rounded-full hover:bg-brand-red/80 transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5 transform font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span data-i18n="projects.liveProject">Live Project</span>
        </a>
      </div>

    </div>
  </div>
</div>

<style>
  .modal-panel {
    animation: modalIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.96) translateY(10px); }
    to   { opacity: 1; transform: scale(1)    translateY(0);     }
  }
</style>

<script>
  import { getTagStyle } from '../data/techColors'

  interface ProjectData {
    title: string;
    description: string;
    descriptionEs: string;
    tags: string[];
    images: string[];
    githubLink: string;
    liveLink: string;
  }

  const modal    = document.getElementById('projectModal')!;
  const track    = document.getElementById('carouselTrack')!;
  const dots     = document.getElementById('carouselDots')!;
  const prevBtn  = document.getElementById('carouselPrev')!;
  const nextBtn  = document.getElementById('carouselNext')!;
  const closeBtn = document.getElementById('modalClose')!;

  let currentIndex = 0;
  let images: string[] = [];

  function updateSlide() {
    (track as HTMLElement).style.transform = `translateX(-${currentIndex * 100}%)`;
    dots.querySelectorAll<HTMLButtonElement>('.dot').forEach((dot, i) => {
      dot.classList.toggle('bg-white',    i === currentIndex);
      dot.classList.toggle('bg-white/40', i !== currentIndex);
    });
  }

  function openModal(data: ProjectData) {
    document.getElementById('modalTitle')!.textContent = data.title;

    document.getElementById('modalDescEn')!.textContent = data.description;
    document.getElementById('modalDescEs')!.textContent = data.descriptionEs;

    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    document.getElementById('modalDescEn')!.style.display = lang === 'es' ? 'none' : '';
    document.getElementById('modalDescEs')!.style.display = lang === 'es' ? '' : 'none';

    // Tags — official tech brand colors via techColors.ts
    const tagsEl = document.getElementById('modalTags')!;
    tagsEl.innerHTML = data.tags.map((tag, i) => {
      const s = getTagStyle(tag, i);
      return `<span style="background:${s.background};color:${s.color};border:1px solid ${s.border}" class="px-3 py-1 rounded-full text-xs font-semibold">${tag}</span>`;
    }).join('');

    const githubEl = document.getElementById('modalGithub') as HTMLAnchorElement;
    githubEl.href = data.githubLink;

    const liveEl = document.getElementById('modalLive') as HTMLAnchorElement;
    if (data.liveLink) {
      liveEl.href = data.liveLink;
      liveEl.classList.remove('hidden');
    } else {
      liveEl.classList.add('hidden');
    }

    images = data.images;
    currentIndex = 0;
    track.innerHTML = images.map((src, i) =>
      `<img src="${src}" alt="${data.title} - image ${i + 1} of ${images.length}" class="w-full h-full object-cover flex-shrink-0" style="min-width:100%" />`
    ).join('');

    const multipleImages = images.length > 1;
    prevBtn.classList.toggle('hidden', !multipleImages);
    nextBtn.classList.toggle('hidden', !multipleImages);
    dots.classList.toggle('hidden', !multipleImages);

    if (multipleImages) {
      dots.innerHTML = images.map((_, i) =>
        `<button class="dot w-2.5 h-2.5 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}" data-index="${i}" aria-label="Go to image ${i + 1}"></button>`
      ).join('');
    }

    updateSlide();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.open-modal-btn');
    if (btn) {
      const raw = btn.getAttribute('data-project');
      if (raw) openModal(JSON.parse(raw) as ProjectData);
    }
  });

  prevBtn.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    updateSlide();
  });

  nextBtn.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % images.length;
    updateSlide();
  });

  dots.addEventListener('click', (e) => {
    const dot = (e.target as Element).closest<HTMLButtonElement>('.dot');
    if (dot) {
      currentIndex = Number(dot.dataset.index);
      updateSlide();
    }
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  document.addEventListener('langChanged', () => {
    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    const descEn = document.getElementById('modalDescEn')!;
    const descEs = document.getElementById('modalDescEs')!;
    if (descEn && descEs) {
      descEn.style.display = lang === 'es' ? 'none' : '';
      descEs.style.display = lang === 'es' ? '' : 'none';
    }
  });
</script>
