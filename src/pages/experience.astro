---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import { experiencesEN, experiencesES } from '../data/experiences';
---

<Layout>
  <main>
    <section class="p-20 flex flex-col items-center">
      <Badge><span data-i18n="experience.badge">My Professional Journey</span></Badge>
      <h1 class="text-3xl font-bold mb-6 mt-4" data-i18n="experience.pageTitle">Professional Experience</h1>

      <div class="timeline-container relative mx-auto max-w-4xl py-8 w-full">

        <!-- English -->
        <div data-lang-content="en">
          {experiencesEN.map((exp) => (
            <div class="timeline-item mb-12 relative">
              <div class="timeline-marker absolute left-0 w-6 h-6 rounded-full bg-brand-navy border-4 border-white z-10"></div>
              <div class="timeline-content ml-12 bg-white p-6 rounded-lg shadow-md relative">
                <div class="absolute left-0 top-6 w-6 h-2 bg-brand-navy -ml-6"></div>
                <span class="inline-block px-3 py-1 text-sm rounded-full bg-brand-gold text-white font-semibold mb-2">{exp.date}</span>
                <h3 class="text-xl font-bold mb-1">{exp.title}</h3>
                <h4 class="text-lg text-brand-red mb-1">{exp.company}</h4>
                <p class="text-gray-600 mb-3 text-sm italic">{exp.location}</p>
                <ul class="text-gray-700 list-disc pl-5 space-y-2">
                  {exp.achievements.map((a) => <li>{a}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <!-- Spanish -->
        <div data-lang-content="es">
          {experiencesES.map((exp) => (
            <div class="timeline-item mb-12 relative">
              <div class="timeline-marker absolute left-0 w-6 h-6 rounded-full bg-brand-navy border-4 border-white z-10"></div>
              <div class="timeline-content ml-12 bg-white p-6 rounded-lg shadow-md relative">
                <div class="absolute left-0 top-6 w-6 h-2 bg-brand-navy -ml-6"></div>
                <span class="inline-block px-3 py-1 text-sm rounded-full bg-brand-gold text-white font-semibold mb-2">{exp.date}</span>
                <h3 class="text-xl font-bold mb-1">{exp.title}</h3>
                <h4 class="text-lg text-brand-red mb-1">{exp.company}</h4>
                <p class="text-gray-600 mb-3 text-sm italic">{exp.location}</p>
                <ul class="text-gray-700 list-disc pl-5 space-y-2">
                  {exp.achievements.map((a) => <li>{a}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>

      </div>

      <a href="/" class="mt-8 bg-brand-navy text-white px-6 py-2 rounded-full hover:bg-brand-navy/80 transition-colors" data-i18n="experience.backHome">
        Back to Home
      </a>
    </section>
  </main>
</Layout>

<style>
  .timeline-container::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0;
    height: 100%;
    width: 2px;
    background-color: #e5e7eb;
  }
</style>
