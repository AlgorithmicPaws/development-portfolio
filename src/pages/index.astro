---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactForm from '../components/ContactForm.astro';
import { projects } from '../data/projects';
---
<Layout>
    <main>
        <!-- Hero Section -->
        <section id="home" class="p-8 md:p-20 flex flex-col md:flex-row justify-center items-center bg-[url(/background-white.png)] bg-cover bg-center w-full min-h-[75vh]">
            <div class="md:pr-10 max-w-full md:max-w-[50%] mb-8 md:mb-0">
                <Badge><span data-i18n="hero.badge">Available for work</span></Badge>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-4 mb-8 text-transparent bg-clip-text bg-gradient-to-r from-brand-navy to-brand-red">Hey, I'm Sergio Florez</h1>
                <h2 class="text-lg md:text-xl text-balance">
                    <span class="text-brand-navy font-semibold" data-i18n="hero.role1">Computer scientist</span><span data-i18n="hero.desc1"> passionate about web development. </span><span class="text-brand-navy font-semibold" data-i18n="hero.role2">Full-stack developer</span><span data-i18n="hero.desc2"> with +2 years of experience building useful and stylish web apps. From Bogota, Colombia 🇨🇴.</span>
                </h2>
                <div class="flex justify-start mt-8 pr-10">
                    <div class="flex justify-center gap-3">
                        <a href="https://github.com/Algorithmicpaws" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="bg-brand-navy text-white px-5 py-2 rounded-full hover:bg-brand-navy/80 transition-all duration-300 transform hover:-translate-y-1 shadow-md hover:shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                            </svg>
                        </a>
                        <a href="https://www.linkedin.com/in/sergio-florez01/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="bg-brand-navy text-white px-5 py-2 rounded-full hover:bg-brand-navy/80 transition-all duration-300 transform hover:-translate-y-1 shadow-md hover:shadow-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                                <rect x="2" y="9" width="4" height="12"></rect>
                                <circle cx="4" cy="4" r="2"></circle>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="relative">
                <div class="absolute -inset-0.5 rounded-full opacity-75 blur"></div>
                <img class="relative ml-0 md:ml-6 min-w-80 min-h-80 w-64 h-64 rounded-full shadow-2xl object-cover" src="https://avatars.githubusercontent.com/u/110072366?v=4" alt="Sergio Florez" />
            </div>
        </section>

        <!-- Color Divider -->
        <div class="min-w-0 max-w-8xl w-full">
            <div class="min-w-0 w-full bg-brand-red h-3"></div>
            <div class="min-w-0 w-full bg-brand-orange h-3"></div>
            <div class="min-w-0 w-full bg-brand-gold h-3"></div>
            <div class="min-w-0 w-full bg-brand-navy h-3"></div>
        </div>

        <!-- Projects Section -->
        <section id="projects" class="flex flex-col p-8 md:p-20 justify-around bg-[url(/background-space-blue.jpg)] bg-cover bg-center w-full">
            <div class="flex gap-3 items-center mb-12">
                <img class="w-12 h-12 rounded-full text-white" src="/projects-icon.svg" alt="Projects" />
                <h2 class="text-2xl md:text-3xl font-bold text-white" data-i18n="projects.title">My Projects</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {projects.map((project) => (
                    <ProjectCard
                        title={project.title}
                        description={project.description}
                        descriptionEs={project.descriptionEs}
                        tags={project.tags}
                        images={project.images}
                        githubLink={project.githubLink}
                        liveLink={project.liveLink}
                    />
                ))}
            </div>
        </section>

        <!-- Color Divider -->
        <div class="min-w-0 max-w-8xl w-full">
            <div class="min-w-0 w-full bg-brand-red h-3"></div>
            <div class="min-w-0 w-full bg-brand-orange h-3"></div>
            <div class="min-w-0 w-full bg-brand-gold h-3"></div>
            <div class="min-w-0 w-full bg-brand-navy h-3"></div>
        </div>

        <!-- Experience Section -->
        <section id="experience" class="flex flex-col p-20 bg-gray-100">
            <div class="flex gap-3 items-center mb-12">
                <img class="w-12 h-12" src="/suitcase.svg" alt="Experience" />
                <h2 class="text-2xl font-bold" data-i18n="experience.title">Professional Experience</h2>
            </div>
            <ExperienceTimeline />
        </section>

        <!-- Color Divider -->
        <div class="min-w-0 max-w-8xl w-full">
            <div class="min-w-0 w-full bg-brand-red h-3"></div>
            <div class="min-w-0 w-full bg-brand-orange h-3"></div>
            <div class="min-w-0 w-full bg-brand-gold h-3"></div>
            <div class="min-w-0 w-full bg-brand-navy h-3"></div>
        </div>

        <!-- Contact Section -->
        <section id="contact" class="flex flex-col p-8 md:p-20 bg-gradient-to-br from-gray-100 to-gray-200">
            <div class="max-w-4xl mx-auto w-full">
                <div class="text-center mb-12">
                    <Badge><span data-i18n="contact.badge">Get in Touch</span></Badge>
                    <h2 class="text-2xl md:text-3xl font-bold mt-4 mb-2" data-i18n="contact.title">Contact Me</h2>
                    <p class="text-gray-700 max-w-lg mx-auto" data-i18n="contact.description">
                        Have a project in mind or want to discuss potential opportunities?
                        Send me a message and I'll get back to you as soon as possible.
                    </p>
                </div>
                <ContactForm />
            </div>
        </section>

        <ProjectModal />

        <!-- Footer -->
        <footer class="bg-brand-navy text-white p-8 text-center">
            <div class="flex justify-center gap-6 mb-4">
                <a href="https://github.com/Algorithmicpaws" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-gray-300 transition-colors p-2 rounded-full hover:bg-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                </a>
                <a href="https://www.linkedin.com/in/sergio-florez01/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-gray-300 transition-colors p-2 rounded-full hover:bg-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect x="2" y="9" width="4" height="12"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                </a>
            </div>
            <p class="text-white/80" data-i18n="footer.credit">Made by Algorthmic Paws 🐾</p>

            <!-- Back to top button -->
            <a href="#home" aria-label="Back to top" class="fixed bottom-6 right-6 bg-brand-navy p-3 rounded-full shadow-lg hover:bg-brand-navy/80 transition-all duration-300 hover:-translate-y-1 group">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white transform group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                </svg>
            </a>
        </footer>
    </main>
</Layout>
